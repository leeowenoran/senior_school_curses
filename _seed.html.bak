<!DOCTYPE html><html><body><script>
(function () {
  var now = new Date();
  function pad2(n) { return String(n).padStart(2, '0'); }
  function dateStr(d) { return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); }
  // 模拟 7 天的 progress 数据
  var prog = {};
  var pattern = [
    { lessons: 2, qs: 3 }, { lessons: 5, qs: 8 }, { lessons: 0, qs: 0 },
    { lessons: 3, qs: 4 }, { lessons: 6, qs: 12 }, { lessons: 1, qs: 2 },
    { lessons: 4, qs: 7 }  // 今天
  ];
  var noon = function (i) { var d = new Date(now.getFullYear(), now.getMonth(), now.getDate() - (6 - i), 12, 0, 0); return d.getTime(); };
  for (var i = 0; i < 7; i++) {
    for (var l = 0; l < pattern[i].lessons; l++) prog['chinese/bx1/u1/' + (i * 10 + l)] = { ts: noon(i) + l * 60000 };
  }
  localStorage.setItem('gz_progress', JSON.stringify(prog));
  // 模拟 quiz log
  var log = [];
  for (var i = 0; i < 7; i++) {
    for (var q = 0; q < pattern[i].qs; q++) log.push({ ts: noon(i) + q * 30000, key: 'k' + i, right: q % 2 === 0 });
  }
  localStorage.setItem('gz_quiz_log', JSON.stringify(log));
  // checkin
  var hist = [];
  for (var i = 0; i < 7; i++) hist.push(dateStr(new Date(now.getFullYear(), now.getMonth(), now.getDate() - (6 - i))));
  localStorage.setItem('gz_checkin', JSON.stringify({ lastDate: dateStr(now), streak: 7, total: 7, history: hist, todayLuck: null, luckDate: '' }));
  // 强制浅色
  localStorage.setItem('gz_theme', 'light');
  location.replace('/index.html#/progress');
})();
</script></body></html>
